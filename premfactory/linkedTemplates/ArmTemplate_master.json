{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "premfactory"
		},
		"AzureBlobStorage1_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'AzureBlobStorage1'"
		},
		"AzureDataLakeStorage1_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'AzureDataLakeStorage1'"
		},
		"HttpServer1_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'HttpServer1'"
		},
		"linkgit_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'linkgit'"
		},
		"linkserviceDl_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'linkserviceDl'"
		},
		"ls_sqlseverdatabase_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_sqlseverdatabase'"
		},
		"AzureDataLakeStorage1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://govindagovinda.dfs.core.windows.net/"
		},
		"HttpServer1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://raw.githubusercontent.com/"
		},
		"HttpServer1_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "Sasidharreddy"
		},
		"gitcop_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://github.com/"
		},
		"linkgit_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://github.com"
		},
		"linkgit_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "Sasidharreddy"
		},
		"linkserviceDl_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adfapril2026.dfs.core.windows.net/"
		},
		"ls_sqlseverdatabase_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "testserver290899.database.windows.net"
		},
		"ls_sqlseverdatabase_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sqldatabase1"
		},
		"ls_sqlseverdatabase_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "Sasidharreddy"
		},
		"githubserver_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://raw.githubusercontent.com/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "premfactory_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureBlobStorage1_connectionString": {
						"value": "[parameters('AzureBlobStorage1_connectionString')]"
					},
					"AzureDataLakeStorage1_accountKey": {
						"value": "[parameters('AzureDataLakeStorage1_accountKey')]"
					},
					"HttpServer1_password": {
						"value": "[parameters('HttpServer1_password')]"
					},
					"linkgit_password": {
						"value": "[parameters('linkgit_password')]"
					},
					"linkserviceDl_accountKey": {
						"value": "[parameters('linkserviceDl_accountKey')]"
					},
					"ls_sqlseverdatabase_password": {
						"value": "[parameters('ls_sqlseverdatabase_password')]"
					},
					"AzureDataLakeStorage1_properties_typeProperties_url": {
						"value": "[parameters('AzureDataLakeStorage1_properties_typeProperties_url')]"
					},
					"HttpServer1_properties_typeProperties_url": {
						"value": "[parameters('HttpServer1_properties_typeProperties_url')]"
					},
					"HttpServer1_properties_typeProperties_userName": {
						"value": "[parameters('HttpServer1_properties_typeProperties_userName')]"
					},
					"gitcop_properties_typeProperties_url": {
						"value": "[parameters('gitcop_properties_typeProperties_url')]"
					},
					"linkgit_properties_typeProperties_url": {
						"value": "[parameters('linkgit_properties_typeProperties_url')]"
					},
					"linkgit_properties_typeProperties_userName": {
						"value": "[parameters('linkgit_properties_typeProperties_userName')]"
					},
					"linkserviceDl_properties_typeProperties_url": {
						"value": "[parameters('linkserviceDl_properties_typeProperties_url')]"
					},
					"ls_sqlseverdatabase_properties_typeProperties_server": {
						"value": "[parameters('ls_sqlseverdatabase_properties_typeProperties_server')]"
					},
					"ls_sqlseverdatabase_properties_typeProperties_database": {
						"value": "[parameters('ls_sqlseverdatabase_properties_typeProperties_database')]"
					},
					"ls_sqlseverdatabase_properties_typeProperties_userName": {
						"value": "[parameters('ls_sqlseverdatabase_properties_typeProperties_userName')]"
					},
					"githubserver_properties_typeProperties_url": {
						"value": "[parameters('githubserver_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "premfactory_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'premfactory_ArmTemplate_0')]"
			]
		}
	]
}